{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>eldoriarpg/.github"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "reviewers": [
    "RainbowDashLabs"
  ],
  "packageRules": [
    {
      "description": "The Playwright image of the frontend job must match the Playwright package, so both wait the same 14 days",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ],
      "groupName": "playwright",
      "minimumReleaseAge": "14 days"
    }
  ]
}
